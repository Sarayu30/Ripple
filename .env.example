# Copy this file to .env. Never commit .env.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Set to a vision-capable model available in your Groq account.
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
AGENT_CONCURRENCY=1
REQUEST_INTERVAL_SECONDS=4
MAX_PROVIDER_ATTEMPTS=4
MAX_COMPLETION_TOKENS=5000
MAX_UPLOAD_MB=100
MAX_DURATION_SECONDS=180
DATA_DIR=./data
# Neon: copy your PostgreSQL connection string, keeping sslmode=require.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DATABASE_SCHEMA=ripple
# Optional local password. Set before exposing even on your LAN.
APP_PASSWORD=

# Account login: keep local for private development; use neon for public accounts.
# Enable Better Auth in Neon first. A database named auth alone is not sufficient.
# Copy Auth Base URL (Configuration), never a database URL, into this public field.
AUTH_MODE=local
NEON_AUTH_BASE_URL=

# Production backend. Set secrets in your host's encrypted environment settings.
APP_ENV=development
PUBLIC_ORIGIN=
ALLOWED_HOSTS=
ORIGIN_SECRET=
JOB_MODE=inline
PERSISTENT_DATA_CONFIRMED=0
MAX_RUNNING_JOBS=2
MAX_QUEUED_JOBS=8
MAX_WORKSPACE_RUNS=100
DAILY_VIEWER_BUDGET=500
GLOBAL_DAILY_VIEWER_BUDGET=2000
DAILY_CHAT_BUDGET=30
GLOBAL_DAILY_CHAT_BUDGET=200

# Vercel build only: the HTTPS origin of your persistent Python backend.
RIPPLE_BACKEND_ORIGIN=
