# Copy this file to .env. Never commit .env.
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Set to a vision-capable model available in your Groq account.
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AGENT_CONCURRENCY=1
# Up to 4 model-selected tool steps plus one final reaction per viewer.
AGENT_MAX_TOOL_STEPS=4
# Deep Agents coordinator and its two specialists share this model-call budget.
DEEP_MAX_MODEL_CALLS=24
REQUEST_INTERVAL_SECONDS=4
MAX_PROVIDER_ATTEMPTS=4
MAX_COMPLETION_TOKENS=5000
MAX_UPLOAD_MB=100
MAX_DURATION_SECONDS=180
DATA_DIR=./data
# Optional local password. Set before exposing even on your LAN.
APP_PASSWORD=
