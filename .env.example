# Copy this file to .env. Never commit .env.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Set to a vision-capable model available in your Groq account.
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
AGENT_CONCURRENCY=1
REQUEST_INTERVAL_SECONDS=4
MAX_PROVIDER_ATTEMPTS=4
MAX_COMPLETION_TOKENS=5000
MAX_UPLOAD_MB=100
MAX_DURATION_SECONDS=180
DATA_DIR=./data
# Neon: copy your PostgreSQL connection string, keeping sslmode=require.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DATABASE_SCHEMA=ripple
# Optional local password. Set before exposing even on your LAN.
APP_PASSWORD=
